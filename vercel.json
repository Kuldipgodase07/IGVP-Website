{
  "cleanUrls": true,
  "trailingSlash": false,
  "headers": [
    {
      "source": "/assets/(.*)",
      "headers": [
        {
          "key": "Cache-Control",
          "value": "public, max-age=31536000, immutable"
        }
      ]
    }
  ],
  "rewrites": [
    { "source": "/about", "destination": "/about.html" },
    { "source": "/insights", "destination": "/insights.html" },
    { "source": "/careers", "destination": "/careers.html" },
    { "source": "/", "destination": "/index.html" }
  ]
}
